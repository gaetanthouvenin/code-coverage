# Copy to .env (ignored by git) for docker compose.
# Only the bootstrap values live here: every other setting (GitHub App, URLs, uploads, processing,
# notifications, retention...) is stored in the database and edited in the web console
# (Administration > Settings), where it is reloaded without a restart.

# Images run by docker compose: ${IMAGE_PREFIX}-api and ${IMAGE_PREFIX}-web, tag TAG. Keep the default
# prefix for a local build; ghcr.io/<owner>/code-coverage for the images published by the CI.
# IMAGE_PREFIX=code-coverage
TAG=latest

# Password of the PostgreSQL user "cc" created by the db service and used by the Api and the Web.
# With docker-compose.sqlserver.yml, the "sa" password: 8 characters or more, three of upper case,
# lower case, digits and symbols.
DB_PASSWORD=

# Password of the Data Protection certificate mounted from ./secrets/dp.pfx. Mandatory in
# Production: the hosts refuse to start without a protected key ring. Create a development
# certificate with: pwsh scripts/new-dp-certificate.ps1 (reads DP_CERT_PASSWORD from .env).
DP_CERT_PASSWORD=
# Another location of the certificate file (default ./secrets/dp.pfx).
# DP_CERT_FILE=./secrets/dp.pfx

# Loopback ports of the hosts (put a TLS reverse proxy in front of them, see Caddyfile.example).
# API_PORT=8081
# WEB_PORT=8080

# Addresses of the reverse proxy trusted for X-Forwarded-For / X-Forwarded-Proto by the Api and the Web
# (comma-separated). Required behind the TLS proxy: without it the sign-in with GitHub sends an http callback.
# Behind the ports Docker publishes, name the gateway of the compose bridge network (e.g. 172.18.0.1), not
# 127.0.0.1; with Caddy as a container, name its address.
# FORWARDED_KNOWN_PROXIES=

# Serve Swagger UI and Scalar on the Api in Production.
# ENABLE_API_DOCS=false

# OTLP endpoint of an OpenTelemetry collector (traces and metrics); nothing is exported when empty.
# OTEL_EXPORTER_OTLP_ENDPOINT=
