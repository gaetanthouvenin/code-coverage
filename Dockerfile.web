# syntax=docker/dockerfile:1
# Dockerfile.web — image of CodeCoverage.Web: the Blazor Server console.
# Multi-stage SDK -> aspnet, non-root user, /app/data volume, port 8080.
#
#   docker build -f Dockerfile.web -t code-coverage-web:dev .
#
# The restore uses nuget.org only: no private NuGet feed, no build secret.
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
# Version stamped by the CI from GitVersion. The defaults are those of src/Directory.Build.props:
# an empty value would not fall back, MSBuild global properties win.
ARG NUGET_VERSION=1.0.0
ARG ASSEMBLY_SEMVER=1.0.0.0
ARG MAJOR_MINOR_PATCH=1.0.0
ARG INFORMATIONAL_VERSION=1.0.0
WORKDIR /src
# The context is filtered by .dockerignore (root build files and src/ only).
COPY . .
# Folder publish, never single-file.
RUN dotnet publish src/CodeCoverage.Web/CodeCoverage.Web.csproj \
      -c Release -o /app/publish \
      -p:NuGetVersion="${NUGET_VERSION}" \
      -p:AssemblySemVer="${ASSEMBLY_SEMVER}" \
      -p:MajorMinorPatch="${MAJOR_MINOR_PATCH}" \
      -p:InformationalVersion="${INFORMATIONAL_VERSION}"

FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS runtime
# The .NET 10 aspnet base image ships without `adduser`; use the always-present shadow utilities.
RUN groupadd --system --gid 1001 codecoverage \
    && useradd --system --uid 1001 --gid codecoverage --no-create-home codecoverage
WORKDIR /app
COPY --from=build /app/publish .
RUN mkdir -p /app/data/logs && chown -R codecoverage:codecoverage /app/data
USER codecoverage
# Only the bootstrap values come from the environment (ConnectionStrings__CodeCoverage,
# CodeCoverage__Database__Provider, DataProtection__*...); every other setting is stored in the
# database and edited in the web console. The local state (logs, temporary files) lives in the
# /app/data volume; the business data and the Data Protection key ring live in the database.
ENV ASPNETCORE_HTTP_PORTS=8080 \
    CodeCoverage__Database__Provider=PostgreSql \
    Logging__FilePath=/app/data/logs/codecoverage-web-.log
EXPOSE 8080
VOLUME ["/app/data"]
ENTRYPOINT ["dotnet", "CodeCoverage.Web.dll"]
