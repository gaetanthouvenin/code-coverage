<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The "coverage-upload" dotnet tool: standalone, it references no project of the solution. Its only
    coupling with the server is the HTTP contract. It targets the oldest supported LTS as well, and
    rolls forward to any newer runtime installed on the CI agent.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework></TargetFramework>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <RollForward>Major</RollForward>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>coverage-upload</ToolCommandName>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CodeCoverage.Uploader.Tests" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

</Project>
