<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The "coverage-upload" dotnet tool: standalone, it references no project of the solution. Its only
    coupling with the server is the HTTP contract. It targets .NET 10 only (ADR-012): an agent
    without .NET 10 uses the standalone binaries. It rolls forward to any newer runtime.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RollForward>Major</RollForward>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>coverage-upload</ToolCommandName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" Version="2.0.*" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CodeCoverage.Uploader.Tests" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

</Project>
