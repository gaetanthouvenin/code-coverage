<CcDialog @ref="_dialog" Open="@(Key is not null)" Title="@Title" OnClose="CloseAsync">
  <ChildContent>
    <p class="cc-muted">@L["SecretDialog_Text"]</p>
    <CcTextField Label="@L["SecretDialog_NewValue"]" Type="password" AutoComplete="new-password" @bind-Value="_value" Error="@Error" />
  </ChildContent>
  <Actions>
    <CcButton OnClick="CloseAsync">@L["Action_Cancel"]</CcButton>
    <CcButton Variant="CcButtonVariant.Primary" Disabled="@(_busy || string.IsNullOrEmpty(_value))" OnClick="ReplaceAsync">@L["Action_Replace"]</CcButton>
  </Actions>
</CcDialog>
