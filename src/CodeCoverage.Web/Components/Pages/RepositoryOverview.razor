@page "/{Forge}/{Owner}/{Name}"

<PageTitle>@L["PageTitle_Format", Name]</PageTitle>

<CcPageContainer>
  @if (State is PageState.Missing)
  {
    <RepositoryInaccessible />
  }
  else
  {
    <RepositoryHeader Forge="@Forge" Owner="@Owner" Name="@Name"
                      Subtitle="@Subtitle" />

    @if (State is PageState.Loading)
    {
      <div class="cc-panel cc-status-page"><CcLoadingSpinner Label="@L["Loading"]" ShowLabel="true" /></div>
    }
    else if (State is PageState.Failed)
    {
      <div class="cc-panel cc-status-page">
        <CcEmptyState Title="@L["Error_Title"]" Icon="CcIconName.Alert">
          <Actions><CcButton Icon="CcIconName.Refresh" OnClick="LoadAsync">@L["Action_Retry"]</CcButton></Actions>
        </CcEmptyState>
      </div>
    }
    else if (Overview is { IsDisabled: true, HasCoverage: false })
    {
      <div class="cc-panel cc-status-page" data-state="nodata">
        <CcEmptyState Title="@L["Overview_NoDataTitle"]" Icon="CcIconName.Upload">@L["Overview_DisabledText"]</CcEmptyState>
      </div>
    }
    else if (Overview is { HasCoverage: false })
    {
      <div class="cc-panel cc-status-page" data-state="nodata">
        <CcEmptyState Title="@L["Overview_NoDataTitle"]" Icon="CcIconName.Upload">
          <ChildContent>@L["Overview_NoDataText"]</ChildContent>
          <Actions>
            <CcButton Variant="CcButtonVariant.Primary" Icon="CcIconName.Upload" Href="@SetupHref">@L["Overview_SetupAction"]</CcButton>
          </Actions>
        </CcEmptyState>
      </div>
      <UploadSetup Forge="@Forge" Owner="@Owner" Name="@Name" ApiPublicUrl="@Urls.CurrentValue.ApiPublicUrl" />
    }
    else if (Overview is not null)
    {
      @if (Overview.IsDisabled)
      {
        <div data-state="disabled">
          <CcBanner Tone="CcTone.Warning">@L["Overview_DisabledText"]</CcBanner>
        </div>
      }
      <CoverageCards Cards="Overview.Cards" />
      <CoverageHistoryChart Forge="@Forge" Owner="@Owner" Name="@Name" DefaultBranch="@Overview.DefaultBranch"
                            Branches="Overview.Branches" Flags="Overview.Flags" Format="Overview.Format" />

      @if (Activity is { } activity)
      {
        <div class="cc-grid cc-grid--main">
          <RecentCommits Forge="@Forge" Owner="@Owner" Name="@Name" Commits="activity.Commits" />
          <div class="cc-stack">
            <OpenPullRequests Forge="@Forge" Owner="@Owner" Name="@Name" Pulls="activity.Pulls" />
            <BadgeSnippets Badge="activity.Badge" IsPrivate="Overview.IsPrivate" />
          </div>
        </div>
      }
    }
  }
</CcPageContainer>
