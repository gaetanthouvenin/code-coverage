@page "/{Forge}/{Owner}/{Name}/commit/{Sha}"

<PageTitle>@L["PageTitle_Format", Detail?.Title ?? L["Tab_Commits"]]</PageTitle>

<CcPageContainer>
  @if (State is PageState.Missing)
  {
    <RepositoryInaccessible />
  }
  else
  {
    <RepositoryHeader Forge="@Forge" Owner="@Owner" Name="@Name" Title="@(Detail?.Title ?? L["Tab_Commits"])" Crumbs="Crumbs"
                      ActiveTab="RepositoryTab.Commits" OnPermission="PermissionKnown">
      <SubtitleContent>
        @if (Subtitle is { } subtitle)
        {
          @subtitle
          @if (Detail?.PullNumber is { } number)
          {
            @(" · ")<a href="@PullHref(number)" data-link="pull">#@number</a>
          }
        }
      </SubtitleContent>
      <Actions>
        @if (Detail is not null)
        {
          <CommitActions Forge="@Forge" Owner="@Owner" Name="@Name" Sha="@Sha" ShortSha="@Detail.ShortSha" CanAdminister="CanAdminister" OnReprocessed="ReloadAsync" />
        }
      </Actions>
    </RepositoryHeader>

    @if (State is PageState.Loading)
    {
      <div class="cc-panel cc-status-page"><CcLoadingSpinner Label="@L["Loading"]" ShowLabel="true" /></div>
    }
    else if (State is PageState.Failed)
    {
      <div class="cc-panel cc-status-page">
        <CcEmptyState Title="@L["Error_Title"]" Icon="CcIconName.Alert">
          <Actions><CcButton Icon="CcIconName.Refresh" OnClick="LoadAsync">@L["Action_Retry"]</CcButton></Actions>
        </CcEmptyState>
      </div>
    }
    else if (Detail is not null)
    {
      @if (Detail.Config.Errors.Count > 0)
      {
        <CcBanner Tone="CcTone.Danger" Title="@L["Commit_ConfigErrorTitle"]" Class="cc-config-error">
          <ul class="cc-plain-list">
            @foreach (var error in Detail.Config.Errors)
            {
              <li>@error</li>
            }
          </ul>
        </CcBanner>
      }
      <CommitSummary Commit="Detail" />
      <div class="cc-grid cc-grid--2">
        <CommitFlags Flags="Detail.Flags" />
        <PostedStatuses Statuses="Detail.Statuses" />
      </div>
      <UploadSessions Rows="Detail.Uploads" CanRetry="CanAdminister" RetryingKey="@RetryingKey" OnRetry="RetryAsync" />
      <FileTree Forge="@Forge" Owner="@Owner" Name="@Name" Sha="@Sha" Flags="FlagNames" Format="Detail.Format" Compacted="@(Detail.Status is CommitStatus.Compacted)" />
      <ConfigWarnings Config="Detail.Config" />
    }
  }
</CcPageContainer>
