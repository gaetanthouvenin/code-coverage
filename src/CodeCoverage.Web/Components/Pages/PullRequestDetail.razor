@page "/{Forge}/{Owner}/{Name}/pull/{Number:int}"

<PageTitle>@L["PageTitle_Format", Title]</PageTitle>

<CcPageContainer>
  @if (State is PageState.Missing)
  {
    <RepositoryInaccessible />
  }
  else
  {
    <RepositoryHeader Forge="@Forge" Owner="@Owner" Name="@Name" Title="@Title" Crumbs="Crumbs" ActiveTab="RepositoryTab.Pulls">
      <SubtitleContent>
        @if (Detail is { } detail)
        {
          @if (detail.Author is { } author)
          {
            @($"{author} · ")
          }
          <code>@detail.HeadBranch</code>@(" → ")<code>@detail.BaseBranch</code>
          @if (detail.CommentUrl is { } url)
          {
            @(" · ")<a href="@url" rel="noopener noreferrer" target="_blank" data-link="comment">@L["Pull_ViewComment"] <CcIcon Name="CcIconName.External" /></a>
          }
        }
      </SubtitleContent>
    </RepositoryHeader>

    @if (State is PageState.Loading)
    {
      <div class="cc-panel cc-status-page"><CcLoadingSpinner Label="@L["Loading"]" ShowLabel="true" /></div>
    }
    else if (State is PageState.Failed)
    {
      <div class="cc-panel cc-status-page">
        <CcEmptyState Title="@L["Error_Title"]" Icon="CcIconName.Alert">
          <Actions><CcButton Icon="CcIconName.Refresh" OnClick="LoadAsync">@L["Action_Retry"]</CcButton></Actions>
        </CcEmptyState>
      </div>
    }
    else if (Detail is { Comparison: null })
    {
      <div class="cc-panel" data-state="pending">
        <CcEmptyState Title="@L["Pull_ComparisonPending"]" Icon="CcIconName.Clock">@L["Pull_ComparisonPendingText"]</CcEmptyState>
      </div>
    }
    else if (Detail is { Comparison: { } comparison })
    {
      <ComparisonSummary Comparison="comparison" />
      <div class="cc-grid cc-grid--2">
        <BaseExplanation Base="comparison.Base" />
        <DiffTable Lines="comparison.Diff" />
      </div>
    }
  }
</CcPageContainer>
