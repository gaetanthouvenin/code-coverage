@page "/{Forge}/{Owner}/{Name}/commits"
@using CodeCoverage.Web.Mapping

<PageTitle>@L["PageTitle_Format", L["Tab_Commits"]]</PageTitle>

<CcPageContainer>
  @if (State is PageState.Missing)
  {
    <RepositoryInaccessible />
  }
  else
  {
    <RepositoryHeader Forge="@Forge" Owner="@Owner" Name="@Name" Title="@L["Tab_Commits"]" Crumbs="Crumbs">
      <Actions>
        @if (Commits is not null)
        {
          <CcSelectField Label="@L["History_Branch"]" Options="BranchOptions" Value="@Commits.Branch" ValueChanged="ChangeBranch"
                         Pill="true" LeadIcon="CcIconName.Commit" />
        }
      </Actions>
    </RepositoryHeader>

    @if (State is PageState.Loading)
    {
      <div class="cc-panel cc-status-page"><CcLoadingSpinner Label="@L["Loading"]" ShowLabel="true" /></div>
    }
    else if (State is PageState.Failed)
    {
      <div class="cc-panel cc-status-page">
        <CcEmptyState Title="@L["Error_Title"]" Icon="CcIconName.Alert">
          <Actions><CcButton Icon="CcIconName.Refresh" OnClick="LoadAsync">@L["Action_Retry"]</CcButton></Actions>
        </CcEmptyState>
      </div>
    }
    else if (Commits is { Rows.Count: 0 })
    {
      <div class="cc-panel cc-status-page" data-state="empty">
        <CcEmptyState Title="@L["Commits_EmptyTitle"]" Icon="CcIconName.Commit">@L["Commits_EmptyText"]</CcEmptyState>
      </div>
    }
    else if (Commits is not null)
    {
      <section class="cc-panel cc-panel--table">
        <CcTable AriaLabel="@L["Tab_Commits"]">
          <Head>
            <th>@L["Column_Commit"]</th>
            <th>@L["Column_Author"]</th>
            <th>@L["Column_Date"]</th>
            <th class="cc-r">@L["Column_Coverage"]</th>
            <th class="cc-r">Δ</th>
            <th>@L["Column_State"]</th>
            <th class="cc-r">@L["Column_Sessions"]</th>
          </Head>
          <ChildContent>
            @foreach (var row in Commits.Rows)
            {
              <tr @key="row.Sha" data-sha="@row.Sha">
                <td class="cc-commit-cell">
                  <a class="cc-ellip" href="@CommitHref(row.Sha)">@(row.Message ?? row.ShortSha)</a>
                  <code>@row.ShortSha</code>
                </td>
                <td class="cc-nowrap">@(row.Author ?? DisplayFormatter.Dash)</td>
                <td class="cc-muted cc-nowrap" title="@row.At.ToString("f", CultureInfo.CurrentCulture)">@AgeOf(row.At)</td>
                <td class="cc-r cc-num cc-strong">@row.Coverage</td>
                <td class="cc-r">
                  @if (row.Delta is { } delta)
                  {
                    <span class="@DeltaClass(row.Trend) cc-num">@delta</span>
                  }
                  else
                  {
                    <span class="cc-dim">@DisplayFormatter.Dash</span>
                  }
                </td>
                <td><CommitStateBadge Status="row.Status" /></td>
                <td class="cc-r cc-num">@row.Sessions</td>
              </tr>
            }
          </ChildContent>
        </CcTable>
        <CcPager Page="Commits.Page" PageSize="Commits.PageSize" TotalCount="Commits.TotalCount" PageChanged="ChangePage" />
      </section>
    }
  }
</CcPageContainer>
