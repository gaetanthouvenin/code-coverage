@page "/not-found"

<PageTitle>@L["PageTitle_Format", L["NotFound_Title"]]</PageTitle>

<CcPageContainer>
  <div class="cc-panel cc-status-page">
    <CcEmptyState Title="@L["NotFound_Title"]" Icon="CcIconName.Search">
      <ChildContent>@L["NotFound_Description"]</ChildContent>
      <Actions>
        <CcButton Variant="CcButtonVariant.Primary" Href="./">@L["BackHome"]</CcButton>
      </Actions>
    </CcEmptyState>
  </div>
</CcPageContainer>
