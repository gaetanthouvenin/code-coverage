<section class="cc-panel" data-panel="tokens">
  <div class="cc-panel__head">
    <h2 class="cc-panel__title">@Title</h2>
    <div class="cc-panel__tools">
      @if (HasRevoked)
      {
        <label class="cc-flag-check">
          <input type="checkbox" checked="@ShowRevoked" @onchange="ToggleRevokedAsync" data-toggle="revoked" />
          @L["Token_ShowRevoked"]
        </label>
      }
      @Tools
    </div>
  </div>
  @if (Shown.Count == 0)
  {
    <div class="cc-panel__body" data-state="empty">
      <CcEmptyState Title="@L["Token_EmptyTitle"]" Icon="CcIconName.Key">@EmptyDescription</CcEmptyState>
    </div>
  }
  else
  {
    <div class="cc-panel__body">
      <p class="cc-muted">@L["Token_ValueShownOnce"]</p>
      <div class="cc-table-wrap">
        <table class="cc-table">
          <thead>
            <tr>
              <th scope="col">@L["Column_Name"]</th>
              <th scope="col">@L["Column_Hint"]</th>
              <th scope="col">@L["Column_Created"]</th>
              <th scope="col">@L["Column_LastUsed"]</th>
              <th scope="col"><span class="cc-sr-only">@L["Action_Revoke"]</span></th>
            </tr>
          </thead>
          <tbody>
            @foreach (var token in Shown)
            {
              <tr data-token="@token.Id">
                <td>
                  <div class="cc-cell">
                    <span class="cc-thumb"><CcIcon Name="CcIconName.Key" /></span>
                    <div>
                      <strong>@token.Label</strong>
                      @if (token.Imported)
                      {
                        <CcBadge Tone="CcTone.Neutral">@L["Token_Imported"]</CcBadge>
                      }
                      @if (token.IsRevoked)
                      {
                        <CcBadge Tone="CcTone.Danger">@L["Token_Revoked"]</CcBadge>
                      }
                    </div>
                  </div>
                </td>
                <td><code>@token.Hint</code></td>
                <td class="cc-muted cc-nowrap">@Date(token.CreatedAt)</td>
                <td class="cc-muted cc-nowrap">@(token.LastUsedAt is { } used ? Date(used) : L["Token_NeverUsed"])</td>
                <td class="cc-r">
                  @if (!token.IsRevoked)
                  {
                    <CcButton Size="CcButtonSize.Small" Variant="CcButtonVariant.Danger" OnClick="() => AskRevokeAsync(token)"
                              AriaLabel="@L["Token_RevokeOf", token.Label]">
                      @L["Action_Revoke"]
                    </CcButton>
                  }
                </td>
              </tr>
            }
          </tbody>
        </table>
      </div>
    </div>
  }
</section>
