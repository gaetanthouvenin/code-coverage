@if (Open)
{
  <div class="cc-dialog__scrim" @onclick="OnScrimClickAsync">
    <div class="cc-dialog"
         @ref="_panel"
         tabindex="-1"
         role="dialog"
         aria-modal="true"
         aria-labelledby="@_titleId"
         @onclick:stopPropagation="true"
         @onkeydown="OnKeyDownAsync">
      <h2 id="@_titleId">@Title</h2>
      @ChildContent
      @if (Actions is not null)
      {
        <div class="cc-dialog__actions">@Actions</div>
      }
    </div>
  </div>
}
