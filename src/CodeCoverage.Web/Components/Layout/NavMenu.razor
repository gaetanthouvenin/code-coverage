@* Signed out, the public bar: up to 640px its documentation icon gives way to the line of the mobile menu. *@
<CcTopNav Items="Items" Class="@(SignedIn ? null : "cc-topnav__public")">
  <Start>
    @if (Switcher.Count > 0)
    {
      <CcSelectField Class="cc-topnav__org"
                     Label="@L["Org_Switcher"]"
                     Pill="true"
                     LeadIcon="CcIconName.Layers"
                     Options="Switcher"
                     Placeholder="@SwitcherPlaceholder"
                     Value="@CurrentOrganization?.Key"
                     ValueChanged="OnOrganizationChanged" />
    }
  </Start>
  <Actions>
    @* From 1181px; below, the entry stays in the user menu and moves to the mobile menu. Signed out, it stays visible. *@
    <a href="docs"
       class="@(SignedIn ? "cc-round-button cc-topnav__docs" : "cc-round-button cc-topnav__docs cc-topnav__docs--public")"
       aria-label="@L["Nav_Docs"]"
       title="@L["Nav_Docs"]"
       aria-current="@(OnDocs ? "page" : null)">
      <CcIcon Name="CcIconName.Book" />
    </a>
    @* Signed out, the round globe button opens the languages; signed in, they are at the bottom of the user menu. *@
    @if (!SignedIn)
    {
      <CcLanguageMenu />
    }
  </Actions>
  <MobileEnd>
    <a href="docs"
       class="@(OnDocs ? "cc-topnav__tab cc-topnav__mobile-docs cc-topnav__tab--active" : "cc-topnav__tab cc-topnav__mobile-docs")"
       aria-current="@(OnDocs ? "page" : null)">
      <CcIcon Name="CcIconName.Book" />@L["Nav_Docs"]
    </a>
    <CcLanguagePicker Variant="CcLanguagePickerVariant.Row" />
  </MobileEnd>
  <UserMenu>
    @if (Model is not null)
    {
      <CcUserMenu UserName="@Model.Login" RoleLabel="@RoleLabel">
        <a href="account/tokens">@L["Nav_Account"]</a>
        <a href="docs">@L["Nav_Docs"]</a>
        @* A real form post: the sign-out endpoint checks the antiforgery token and clears the cookie. *@
        <form method="post" action="signout" data-enhance="false" class="cc-user-menu__signout">
          <AntiforgeryToken />
          <button type="submit">@L["Nav_SignOut"]</button>
        </form>
        <CcLanguagePicker />
      </CcUserMenu>
    }
    else if (!SignedIn)
    {
      <CcButton Class="cc-topnav__signin" Variant="CcButtonVariant.Primary" Icon="CcIconName.GitHub" Href="@SignInHref">@L["Nav_SignIn"]</CcButton>
    }
  </UserMenu>
</CcTopNav>
