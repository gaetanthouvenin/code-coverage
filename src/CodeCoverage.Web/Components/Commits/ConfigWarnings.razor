<section class="cc-panel" data-panel="config">
  <div class="cc-panel__head">
    <h2 class="cc-panel__title">@L["Commit_Configuration"]</h2>
    <div class="cc-panel__tools">
      @if (Config.Errors.Count > 0)
      {
        <CcBadge Tone="CcTone.Danger" Icon="CcIconName.Alert">@L["Commit_ConfigErrors", Config.Errors.Count]</CcBadge>
      }
      else if (Config.Warnings.Count > 0)
      {
        <CcBadge Tone="CcTone.Warning" Icon="CcIconName.Alert">@L["Commit_ConfigWarnings", Config.Warnings.Count]</CcBadge>
      }
    </div>
  </div>
  <div class="cc-panel__body cc-stack">
    <dl class="cc-kv">
      <dt>@L["Commit_ConfigSource"]</dt>
      <dd>
        @if (Config.Source is { } source)
        {
          @L[source]
        }
        else
        {
          <code>@(Config.RawSource ?? "—")</code>
        }
        @if (Config.Path is { } path)
        {
          <text> · </text><code>@path</code>
        }
      </dd>
    </dl>
    @foreach (var warning in Config.Warnings)
    {
      <CcBanner Tone="CcTone.Warning">@L[warning.Code] <code>@warning.Key</code>@if (warning.Detail is { } detail) { <text> · </text><code>@detail</code> }</CcBanner>
    }
  </div>
</section>
