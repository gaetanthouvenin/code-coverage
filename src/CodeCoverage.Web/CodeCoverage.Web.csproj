<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- ANCM in-process hosting cannot load a single-file bundle: always publish as a folder. -->
    <PublishSingleFile>false</PublishSingleFile>
    <AspNetCoreHostingModel>InProcess</AspNetCoreHostingModel>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CodeCoverage.Web.Tests" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AspNet.Security.OAuth.GitHub" Version="10.*" />
    <PackageReference Include="Markdig" Version="1.*" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.*" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.*" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.*" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" Version="1.*" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.*" />
    <PackageReference Include="Serilog.Enrichers.Environment" Version="3.*" />
    <PackageReference Include="Serilog.Enrichers.Thread" Version="4.*" />
    <PackageReference Include="Serilog.Formatting.Compact" Version="3.*" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.*" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.*" />
  </ItemGroup>

  <!-- The documentation served by /docs (M4.02o): the whitelist of published documents, embedded at build. The slug is
       the address of the page; it must match DocumentationCatalog. Nothing else of docs/ is ever embedded. -->
  <ItemGroup>
    <PublishedDocument Include="..\..\docs\operations.md" Slug="operations" />
    <PublishedDocument Include="..\..\docs\operations\organization-onboarding.md" Slug="organization-onboarding" />
    <PublishedDocument Include="..\..\docs\operations\github-verification-checklist.md" Slug="github-checklist" />
    <PublishedDocument Include="..\..\action\README.md" Slug="github-actions" />
    <PublishedDocument Include="..\..\docs\deployment-azure.md" Slug="deployment-azure" />
    <PublishedDocument Include="..\..\docs\migration-from-codecov.md" Slug="migration-from-codecov" />
  </ItemGroup>

  <!-- The languages of the translations of the documents: the languages of the console but English (ConsoleLanguages,
       checked by DocumentationSourceTests). -->
  <PropertyGroup>
    <DocumentationLanguages>fr;it;es</DocumentationLanguages>
  </PropertyGroup>

  <!-- Each document, and each of its translations (name.{language}.md next to it) that exists. WithCulture=false keeps a
       translation out of the satellite assemblies: the documentation picks the translation itself (M4.02v). -->
  <Target Name="EmbedPublishedDocuments" BeforeTargets="AssignTargetPaths">
    <ItemGroup>
      <_DocumentationLanguage Include="$(DocumentationLanguages)" />
      <_PublishedDocumentInLanguage Include="@(PublishedDocument)">
        <Language>%(_DocumentationLanguage.Identity)</Language>
      </_PublishedDocumentInLanguage>
      <_PublishedTranslation Include="@(_PublishedDocumentInLanguage->'%(RootDir)%(Directory)%(Filename).%(Language)%(Extension)')" />
      <EmbeddedResource Include="@(PublishedDocument)" LogicalName="CodeCoverage.Web.Docs.%(PublishedDocument.Slug).md" WithCulture="false" Type="Non-Resx" />
      <EmbeddedResource Include="@(_PublishedTranslation)" Condition="Exists('%(FullPath)')" LogicalName="CodeCoverage.Web.Docs.%(_PublishedTranslation.Slug).%(_PublishedTranslation.Language).md" WithCulture="false" Type="Non-Resx" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\CodeCoverage.Application\CodeCoverage.Application.csproj" />
    <!-- Composition root only (Program and Configuration): the other types never use Infrastructure. -->
    <ProjectReference Include="..\CodeCoverage.Infrastructure\CodeCoverage.Infrastructure.csproj" />
    <!-- Composition root only (Program): the job claim dialect of each engine, and its migrations deployed next to the executable. -->
    <ProjectReference Include="..\CodeCoverage.Infrastructure.PostgreSql\CodeCoverage.Infrastructure.PostgreSql.csproj" />
    <ProjectReference Include="..\CodeCoverage.Infrastructure.SqlServer\CodeCoverage.Infrastructure.SqlServer.csproj" />
  </ItemGroup>

</Project>
