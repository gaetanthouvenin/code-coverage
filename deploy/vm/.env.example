# deploy/vm/.env.example — copy to .env next to docker-compose.prod.yml and fill in every value.
# Never commit the .env file: it holds the passwords.

# The images of a release: IMAGE_PREFIX of the CI and the version of the tag (without the v).
IMAGE_PREFIX=ghcr.io/<owner>/code-coverage
TAG=1.2.3

# The two public host names (ADR-011) and the ACME contact address.
CC_API_HOST=coverage-api.example.com
CC_WEB_HOST=coverage.example.com
ACME_EMAIL=admin@example.com

# The database password, and the Data Protection certificate and its password (back it up apart).
DB_PASSWORD=
DP_CERT_FILE=./secrets/dp.pfx
DP_CERT_PASSWORD=

# Backups: interval, retention, and the off-machine copy (a shell command; the dump path is $1).
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=14
BACKUP_HOOK=

# Optional: the OTLP endpoint of the metrics (deploy/observability) and the API docs in production.
OTEL_EXPORTER_OTLP_ENDPOINT=
ENABLE_API_DOCS=false

# The job worker of the Api. Set to false on a restored copy (the quarterly restore drill): it runs only
# on the instance that serves production.
WORKER_ENABLED=true

# A host whose reverse proxy already runs in a container, e.g. Nginx Proxy Manager (M4.02b,
# docs/operations.md "Continuous deployment"): uncomment these lines. COMPOSE_FILE adds the override
# that disables Caddy, joins the Api and the Web to the Docker network of the proxy (PROXY_NETWORK, an
# existing network; its subnet in PROXY_NETWORK_CIDR, from `docker network inspect`) and bind-mounts the
# volumes under DATA_DIR (db, backups, api, web, created before the first up). ACME_EMAIL is then unused
# but must keep a value: compose checks every variable of the files, Caddy included.
#COMPOSE_FILE=docker-compose.prod.yml:docker-compose.host.yml
#PROXY_NETWORK=npm_default
#PROXY_NETWORK_CIDR=172.20.0.0/16
#DATA_DIR=/data03/docker/code-coverage/data
