# Verify compares the snapshots byte for byte: they stay LF on every checkout.
*.verified.txt text eol=lf working-tree-encoding=UTF-8

# Fonts are binary: never normalise their line endings.
*.woff2 binary

# Two branches adding a label must not conflict. Safe only with one <data> entry per line
# (checked by Web.Tests/Resources/ResourceEntryFormatTests): on several lines, entries interleave.
Common*.resx merge=union
UiStrings*.resx merge=union
